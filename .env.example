ANTHROPIC_API_KEY=your-api-key-here

# Optional: ElevenLabs speech-to-text + text-to-speech (used by the web UI).
# Get keys at https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Voice ID for POST /api/voice/speak (required for read-aloud).
ELEVENLABS_VOICE_ID=
# Optional overrides:
# ELEVENLABS_STT_MODEL_ID=scribe_v2
# ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_API_BASE=https://api.elevenlabs.io

# Optional: auth token for remote MCP endpoint /api/mcp/manual/ (for ElevenLabs MCP integration).
# If set, callers must send either:
#   Authorization: Bearer <token>
#   X-MCP-Auth-Token: <token>
# VOICE_MANUAL_MCP_TOKEN=
